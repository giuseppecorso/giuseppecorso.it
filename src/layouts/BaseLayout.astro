---
import { Image } from 'astro:assets';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/fraunces/wght.css';
import '../styles/global.css';
import logo from '../assets/logo-volto.png';
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** closing call-to-action band above the footer (off on contact/legal pages) */
  cta?: boolean;
}

const { title, description, jsonLd, noindex = false, cta = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og.jpg', Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Umami: self-hosted, cookieless analytics -->
    <script is:inline defer src="https://stat.giuseppecorso.it/script.js" data-website-id="a1721b8a-9c52-4b4e-9675-db90f69ee047" data-do-not-track="true"></script>

    {jsonLd &&<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-current={path === '/' ? 'page' : undefined}>
          <Image src={logo} alt="" width={48} height={48} densities={[1, 2]} loading="eager" class="brand-mark" />
          <span class="brand-name"><span>Giuseppe</span> <b>Corso</b></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Apri il menu" hidden>
          <span class="bars" aria-hidden="true"></span>
        </button>
        <nav id="menu" aria-label="Principale">
          <ul>
            <li><a href="/progetti/" aria-current={path.startsWith('/progetti') ? 'page' : undefined}>Progetti</a></li>
            <li><a href="/kit-host-italia/" aria-current={path.startsWith('/kit-host-italia') ? 'page' : undefined}>Kit Host Italia</a></li>
            <li><a href="/assistenza/" aria-current={path.startsWith('/assistenza') ? 'page' : undefined}>Assistenza</a></li>
            <li><a href="/chi-sono/" aria-current={path.startsWith('/chi-sono') ? 'page' : undefined}>Chi sono</a></li>
            <li><a class="btn btn--primary btn--small" href="/contatti/" aria-current={path.startsWith('/contatti') ? 'page' : undefined}>Scrivimi</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <script is:inline>
      // Small screens: the menu collapses behind a button. Without JavaScript it simply stays open.
      (() => {
        const button = document.querySelector('.menu-toggle');
        const nav = document.getElementById('menu');
        if (!button || !nav) return;
        document.documentElement.classList.add('has-menu');
        button.hidden = false;
        const set = (open) => {
          nav.classList.toggle('open', open);
          button.setAttribute('aria-expanded', String(open));
          button.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
        };
        button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') { set(false); button.focus(); }
        });
      })();
    </script>

    <main id="main">
      <slot />
    </main>

    {cta && (
      <section class="section band band--ink closing" aria-labelledby="closing-title">
        <div class="container closing-inner">
          <div>
            <h2 id="closing-title">Hai un progetto da far partire, o un sito da sistemare?</h2>
            <p class="lead">Raccontami cosa ti serve: ti rispondo io, con tempi e costi chiari.</p>
          </div>
          <div class="btn-row">
            <a class="btn btn--primary" href="/contatti/">Scrivimi</a>
            <a class="btn btn--light" href="/progetti/">Guarda i progetti</a>
          </div>
        </div>
      </section>
    )}

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} {SITE.name}</p>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href="/sito-web-bb/">Siti per B&B</a></li>
          <li><a href="/riparazione-sito-wordpress/">Riparazioni WordPress</a></li>
          <li><a href={SITE.github} rel="noopener">GitHub</a></li>
          <li><a href={SITE.linkedin} rel="noopener">LinkedIn</a></li>
          <li><a href={SITE.fiverr} rel="noopener">Fiverr</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); }
  nav ul, .footer-inner ul { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  nav a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 500; font-size: .95rem; }
  nav a:not(.btn):hover, nav a:not(.btn)[aria-current='page'] { color: var(--accent); text-decoration: underline; }
  .closing-inner { display: grid; gap: 1.5rem; align-items: center; }
  .closing h2 { margin-bottom: .5rem; }
  .closing .lead { margin: 0; }
  .closing .btn-row { margin-top: 0; }
  @media (min-width: 56rem) { .closing-inner { grid-template-columns: 1fr auto; gap: 3rem; } }
  .site-footer { background: var(--ink); border-top: 1px solid #3a3e45; padding: 2rem 0; color: #c9ccd1; font-size: .95rem; }
  .site-footer a { color: #fff; }
  .site-footer a:hover { color: var(--mint); }
  .footer-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .footer-inner p { margin: 0; }
  /* hamburger: only below 48rem, and only when the script has run */
  .menu-toggle { display: none; }
  @media (max-width: 47.99rem) {
    .header-inner { flex-wrap: wrap; }
    .menu-toggle:not([hidden]) {
      display: grid; place-items: center; width: 2.9rem; height: 2.9rem; padding: 0;
      border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); cursor: pointer;
    }
    .bars, .bars::before, .bars::after { display: block; width: 1.35rem; height: 2px; border-radius: 2px; background: var(--ink); transition: transform .2s, opacity .2s; }
    .bars { position: relative; }
    .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
    .bars::before { top: -7px; }
    .bars::after { top: 7px; }
    .menu-toggle[aria-expanded='true'] .bars { background: transparent; }
    .menu-toggle[aria-expanded='true'] .bars::before { transform: translateY(7px) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] .bars::after { transform: translateY(-7px) rotate(-45deg); }
    :global(.has-menu) nav { display: none; flex-basis: 100%; }
    :global(.has-menu) nav.open { display: block; }
    nav ul { flex-direction: column; align-items: stretch; gap: 0; padding: .5rem 0 .75rem; }
    nav a:not(.btn) { display: block; padding: .85rem .25rem; font-size: 1.1rem; border-bottom: 1px solid var(--line); }
    nav .btn { display: block; text-align: center; margin-top: 1rem; }
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-top: 1rem; padding-bottom: 1rem; }
  .brand { display: flex; align-items: center; gap: .65rem; color: var(--ink); text-decoration: none; }
  /* wordmark: one word, uppercase, first name in ink and surname in teal */
  /* inline-flex drops the space between the two words: read "Giuseppe Corso", shown attached */
  .brand-name { display: inline-flex; font-family: var(--font-body); font-weight: 800; font-size: 1.15rem; letter-spacing: .01em; text-transform: uppercase; line-height: 1; }
  .brand-name b { font-weight: 800; color: var(--accent); }
  .brand-mark { width: 48px; height: 48px; mix-blend-mode: multiply; }
</style>
