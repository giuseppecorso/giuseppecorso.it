---
import { getImage, Image } from 'astro:assets';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/fraunces/wght.css';
import '../styles/global.css';
import photo from '../assets/giuseppe-corso-ritratto.jpg';
import avatar from '../assets/giuseppe-corso-avatar.jpg';
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: photo, width: 600, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />

    <!-- Umami: self-hosted, cookieless analytics -->
    <script is:inline defer src="https://stat.giuseppecorso.it/script.js" data-website-id="a1721b8a-9c52-4b4e-9675-db90f69ee047" data-do-not-track="true"></script>

    {jsonLd &&<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-current={path === '/' ? 'page' : undefined}>Giuseppe Corso</a>
        <nav aria-label="Principale">
          <ul>
            <li><a href="/progetti/" aria-current={path.startsWith('/progetti') ? 'page' : undefined}>Progetti</a></li>
            <li><a href="/kit-host-italia/" aria-current={path.startsWith('/kit-host-italia') ? 'page' : undefined}>Kit Host Italia</a></li>
            <li><a href="/assistenza/" aria-current={path.startsWith('/assistenza') ? 'page' : undefined}>Assistenza</a></li>
            <li><a href="/chi-sono/" aria-current={path.startsWith('/chi-sono') ? 'page' : undefined}>Chi sono</a></li>
            <li><a href={`mailto:${SITE.email}`}>Contatti</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="who">
          <Image src={avatar} alt="Fotografia di Giuseppe Corso" width={44} height={44} densities={[1, 2]} class="avatar" loading="lazy" />
          <span>© {new Date().getFullYear()} {SITE.name}</span>
        </p>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.github} rel="noopener">GitHub</a></li>
          <li><a href={SITE.linkedin} rel="noopener">LinkedIn</a></li>
          <li><a href={SITE.fiverr} rel="noopener">Fiverr</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-top: 1rem; padding-bottom: 1rem; }
  .brand { font-family: var(--font-display); font-weight: 400; font-size: 1.3rem; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; }
  nav ul, .footer-inner ul { display: flex; flex-wrap: wrap; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--ink); text-decoration: none; font-weight: 400; font-size: .95rem; }
  nav a:hover, nav a[aria-current='page'] { color: var(--accent); text-decoration: underline; }
  .site-footer { border-top: 1px solid var(--line); padding: 2rem 0; color: var(--muted); font-size: .95rem; }
  .footer-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .footer-inner p { margin: 0; }
  .who { display: flex; align-items: center; gap: .75rem; }
  .avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 1px solid var(--line); }
</style>
