---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import character from '../assets/personaggio/personaggio-attrezzi.jpg';
import { SITE } from '../site';
---

<BaseLayout
  title="Assistenza WordPress, WooCommerce e PrestaShop — Giuseppe Corso"
  description="Assistenza per siti WordPress, negozi WooCommerce e PrestaShop: correzioni, personalizzazioni di temi e plugin, SEO tecnica, gestione del catalogo."
>
  <section class="section intro">
    <div class="container intro-inner">
      <div>
        <p class="eyebrow">Assistenza</p>
        <h1>Il tuo sito ha bisogno di <span class="mark">una mano</span>?</h1>
        <p class="lead">
          Lavoro con WordPress dal 2013. Se il tuo sito o il tuo negozio online non fa quello che dovrebbe, ecco dove posso aiutarti.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={SITE.fiverr} rel="noopener">Vai al mio profilo Fiverr</a>
          <a class="btn btn--ghost" href="/contatti/">Scrivimi</a>
        </div>
      </div>
      <Image
        src={character}
        alt="Giuseppe Corso disegnato a matita con un portatile aperto in mano"
        widths={[340, 680]}
        sizes="(min-width: 48rem) 340px, 70vw"
        loading="eager"
        fetchpriority="high"
        class="character"
      />
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="servizi">
    <div class="container">
      <p class="eyebrow">Cosa faccio</p>
      <h2 id="servizi">Tre piattaforme che conosco bene</h2>
      <div class="grid grid--3 services">
        <article class="card">
          <h3>WordPress</h3>
          <p>Personalizzazioni di temi, template e plugin in HTML, CSS e PHP. Ottimizzazione SEO tecnica e on-page.</p>
        </article>
        <article class="card">
          <h3>WooCommerce</h3>
          <p>Negozi online su WordPress: messa a punto, personalizzazioni e sistemazione di quello che non funziona come dovrebbe.</p>
        </article>
        <article class="card">
          <h3>PrestaShop</h3>
          <p>Negozi nuovi e gestione di cataloghi con migliaia di articoli: importazioni ed esportazioni massive da listini, automazioni per eBay, pulizia e correzione dei dati.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container how">
      <p class="eyebrow">Come funziona</p>
      <h2>Semplice e tracciato</h2>
      <p>
        Gli incarichi passano da Fiverr: descrivi il problema, ti rispondo con tempi e costo, e il pagamento è gestito dalla piattaforma.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-inner { display: grid; gap: 2.5rem; align-items: center; }
  .character { justify-self: center; width: min(70vw, 340px); height: auto; mix-blend-mode: multiply; }
  @media (min-width: 48rem) {
    .intro-inner { grid-template-columns: 1fr auto; gap: 4rem; }
  }
  .services { margin-top: 2rem; }
  .how { max-width: 44rem; }
</style>
