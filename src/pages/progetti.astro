---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const progetti = (await getCollection('progetti')).sort((a, b) => a.data.order - b.data.order);
const clienti = (await getCollection('clienti')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(progetti.map(async (p) => ({ p, Content: (await render(p)).Content })));
---

<BaseLayout
  title="Progetti software e siti web realizzati — Giuseppe Corso"
  description="Progetti software di Giuseppe Corso: e-commerce Spring Boot e Angular, analisi statistica in Python, automazioni Excel/VBA. Più i siti web che ho realizzato."
>
  <section class="section intro">
    <div class="container">
      <p class="eyebrow">Portfolio</p>
      <h1>Progetti</h1>
      <p class="lead">
        Scorri le schede e soffermati su quella che ti interessa: si apre con il problema, cosa ho costruito, le
        tecnologie e dove vederla.
      </p>
    </div>
  </section>

  <!-- Carousel 1: software projects -->
  <section class="section carousel" aria-roledescription="carousel" aria-labelledby="software">
    <div class="container">
      <div class="carousel-head">
        <div>
          <p class="eyebrow">Software</p>
          <h2 id="software">Applicazioni che ho costruito</h2>
        </div>
        <div class="carousel-controls">
          <button type="button" class="ctl" data-direction="previous" aria-label="Scheda precedente">←</button>
          <button type="button" class="ctl" data-autoplay aria-pressed="false" aria-label="Ferma lo scorrimento automatico" hidden>❚❚</button>
          <button type="button" class="ctl" data-direction="next" aria-label="Scheda successiva">→</button>
        </div>
      </div>
    </div>
    <div class="track" tabindex="0" role="group" aria-label="Schede dei progetti software">
      {rendered.map(({ p }, i) => (
        <div class="slide card" id={p.id} role="group" aria-roledescription="slide" aria-label={`${i + 1} di ${rendered.length}`}>
          <p class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3>{p.data.title}</h3>
          <p class="summary">{p.data.summary}</p>
          <ul class="tags" aria-label="Tecnologie">
            {p.data.tech.slice(0, 5).map((t) => <li>{t}</li>)}
          </ul>
          <button type="button" class="open" command="show-modal" commandfor={`scheda-${p.id}`}>Apri la scheda →</button>
        </div>
      ))}
    </div>
    <p class="visually-hidden" role="status" aria-live="polite"></p>
  </section>

  <!-- Carousel 2: websites -->
  <section class="section section--soft carousel" aria-roledescription="carousel" aria-labelledby="clienti">
    <div class="container">
      <div class="carousel-head">
        <div>
          <p class="eyebrow">Online</p>
          <h2 id="clienti">Siti web realizzati</h2>
        </div>
        <div class="carousel-controls">
          <button type="button" class="ctl" data-direction="previous" aria-label="Sito precedente">←</button>
          <button type="button" class="ctl" data-autoplay aria-pressed="false" aria-label="Ferma lo scorrimento automatico" hidden>❚❚</button>
          <button type="button" class="ctl" data-direction="next" aria-label="Sito successivo">→</button>
        </div>
      </div>
    </div>
    <div class="track" tabindex="0" role="group" aria-label="Schede dei siti web">
      {clienti.map((c, i) => (
        <div class="slide card site" role="group" aria-roledescription="slide" aria-label={`${i + 1} di ${clienti.length}`}>
          <Image src={c.data.screenshot} alt={c.data.screenshotAlt} widths={[400, 800]} sizes="(min-width: 48rem) 400px, 82vw" class="shot" />
          <div class="site-body">
            <h3>{c.data.title}</h3>
            <p class="business">{c.data.business}</p>
            <ul class="tags" aria-label="Tecnologie">
              {c.data.tech.slice(0, 4).map((t) => <li>{t}</li>)}
            </ul>
            <button type="button" class="open" command="show-modal" commandfor={`scheda-sito-${c.id}`}>Apri la scheda →</button>
          </div>
        </div>
      ))}
    </div>
    <p class="visually-hidden" role="status" aria-live="polite"></p>
  </section>

  <!-- Detail sheets: native modal dialogs, "projected" over a dimmed page -->
  {rendered.map(({ p, Content }) => (
    <dialog class="sheet" id={`scheda-${p.id}`} aria-labelledby={`t-${p.id}`} closedby="any">
      <form method="dialog" class="sheet-close"><button aria-label="Chiudi la scheda" autofocus>×</button></form>
      <div class="sheet-body">
        <p class="eyebrow">Progetto software</p>
        <h2 id={`t-${p.id}`}>{p.data.title}</h2>
        <p class="summary">{p.data.summary}</p>
        <h3>Il problema</h3>
        <p>{p.data.problem}</p>
        <h3>Cosa ho costruito</h3>
        <Content />
        {p.data.note && <p class="note">{p.data.note}</p>}
        <ul class="tags" aria-label="Tecnologie">
          {p.data.tech.map((t) => <li>{t}</li>)}
        </ul>
        {p.data.links.length > 0 && (
          <ul class="links">
            {p.data.links.map((l) => <li><a href={l.url} rel="noopener">{l.label} →</a></li>)}
          </ul>
        )}
      </div>
    </dialog>
  ))}
  {clienti.map((c) => (
    <dialog class="sheet" id={`scheda-sito-${c.id}`} aria-labelledby={`t-sito-${c.id}`} closedby="any">
      <form method="dialog" class="sheet-close"><button aria-label="Chiudi la scheda" autofocus>×</button></form>
      <Image src={c.data.screenshot} alt="" widths={[720, 1440]} sizes="(min-width: 48rem) 720px, 92vw" class="sheet-shot" loading="lazy" />
      <div class="sheet-body">
        <p class="eyebrow">{c.data.business}</p>
        <h2 id={`t-sito-${c.id}`}>{c.data.title}</h2>
        <p>{c.data.work}</p>
        <ul class="tags" aria-label="Tecnologie">
          {c.data.tech.map((t) => <li>{t}</li>)}
        </ul>
        <ul class="links">
          {c.data.url && <li><a href={c.data.url} rel="noopener">Visita il sito →</a></li>}
          {c.data.detailUrl && (
            <li><button type="button" class="linklike" data-switch={`scheda-${c.data.detailUrl.replace('#', '')}`}>Dettagli tecnici →</button></li>
          )}
        </ul>
      </div>
    </dialog>
  ))}
</BaseLayout>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const outside = (e: PointerEvent | MouseEvent, el: Element) => {
    const r = el.getBoundingClientRect();
    return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
  };
  const anySheetOpen = () => document.querySelector('dialog.sheet[open]') !== null;

  // ---------- detail sheets ----------
  const sheets = [...document.querySelectorAll<HTMLDialogElement>('dialog.sheet')];
  // where the mouse was when a sheet was opened by hovering, and whether it has reached the sheet since
  let hover: { x: number; y: number; entered: boolean } | null = null;
  /** Open the sheet in the middle of the screen. `from` is set when it was opened by hovering. */
  const openSheet = (d: HTMLDialogElement, from?: { x: number; y: number }) => {
    if (d.open) return;
    d.showModal();
    d.scrollTop = 0;
    hover = from ? { ...from, entered: false } : null;
  };

  for (const d of sheets) {
    d.addEventListener('close', () => { hover = null; });
    // opened by hovering: it closes when the mouse wanders off, unless it went onto the sheet first
    d.addEventListener('pointermove', (e) => {
      if (!hover || e.pointerType !== 'mouse') return;
      if (!outside(e, d)) hover.entered = true;
      else if (hover.entered || Math.hypot(e.clientX - hover.x, e.clientY - hover.y) > 160) d.close();
    });
    // click outside to close, where the closedby attribute is not supported yet
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      let pressedOutside = false;
      d.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, d); });
      d.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e, d)) d.close(); });
    }
  }

  const nativeCommands = 'commandForElement' in HTMLButtonElement.prototype;
  for (const slide of document.querySelectorAll<HTMLElement>('.slide')) {
    const button = slide.querySelector<HTMLButtonElement>('.open');
    const sheet = button && (document.getElementById(button.getAttribute('commandfor') ?? '') as HTMLDialogElement | null);
    if (!button || !sheet) continue;
    // buttons open the sheet natively (command="show-modal"); script only where that is missing
    if (!nativeCommands) button.addEventListener('click', () => openSheet(sheet));

    // mouse only: resting on a card for a moment "projects" its sheet
    let timer = 0;
    let at = { x: 0, y: 0 };
    slide.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      at = { x: e.clientX, y: e.clientY };
      timer = window.setTimeout(() => { if (!anySheetOpen()) openSheet(sheet, at); }, 900);
    });
    slide.addEventListener('pointermove', (e) => { at = { x: e.clientX, y: e.clientY }; });
    slide.addEventListener('pointerleave', () => clearTimeout(timer));
    slide.addEventListener('pointerdown', () => clearTimeout(timer));
  }

  // "Dettagli tecnici": jump from a website sheet to the matching software sheet
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-switch]')) {
    b.addEventListener('click', () => {
      const target = document.getElementById(b.dataset.switch ?? '') as HTMLDialogElement | null;
      b.closest('dialog')?.close();
      if (target) openSheet(target);
    });
  }

  // a link like /progetti/#curio-lane opens that project's sheet
  const linked = document.getElementById(`scheda-${location.hash.slice(1)}`) as HTMLDialogElement | null;
  if (location.hash.length > 1 && linked) openSheet(linked);

  // ---------- carousels ----------
  for (const carousel of document.querySelectorAll<HTMLElement>('.carousel')) {
    const track = carousel.querySelector<HTMLElement>('.track')!;
    const slides = [...track.children] as HTMLElement[];
    const status = carousel.querySelector<HTMLElement>('[role="status"]')!;
    const toggle = carousel.querySelector<HTMLButtonElement>('[data-autoplay]')!;
    let byUser = false;
    let settled = 0;

    const position = (s: HTMLElement) => s.offsetLeft - slides[0].offsetLeft;
    const current = () => {
      let best = 0;
      slides.forEach((s, i) => { if (Math.abs(position(s) - track.scrollLeft) < Math.abs(position(slides[best]) - track.scrollLeft)) best = i; });
      return best;
    };
    const atEnd = () => track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    const go = (step: number) => {
      const i = current();
      // wrap around: after the last card back to the first, and the other way round
      const next = step > 0 ? (atEnd() ? 0 : i + 1) : i === 0 ? slides.length - 1 : i - 1;
      track.scrollTo({ left: position(slides[Math.min(next, slides.length - 1)]), behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    };

    for (const b of carousel.querySelectorAll<HTMLButtonElement>('[data-direction]')) {
      b.addEventListener('click', () => { byUser = true; go(b.dataset.direction === 'next' ? 1 : -1); });
    }

    // announce the card only after scrolling the user started has settled (not on automatic moves)
    const onSettled = () => {
      const i = current();
      if (byUser && i !== settled) status.textContent = `Scheda ${i + 1} di ${slides.length}`;
      settled = i;
      byUser = false;
    };
    if ('onscrollend' in window) track.addEventListener('scrollend', onSettled);
    else {
      let t = 0;
      track.addEventListener('scroll', () => { clearTimeout(t); t = window.setTimeout(onSettled, 150); });
    }
    for (const type of ['wheel', 'touchstart', 'keydown'] as const) track.addEventListener(type, () => { byUser = true; }, { passive: true });

    // automatic scrolling: only when motion is welcome, never while someone is reading a card
    if (!reduceMotion.matches && track.scrollWidth > track.clientWidth + 4) {
      toggle.hidden = false;
      let stopped = false;
      let busy = false;
      toggle.addEventListener('click', () => {
        stopped = !stopped;
        toggle.setAttribute('aria-pressed', String(stopped));
        toggle.setAttribute('aria-label', stopped ? 'Riprendi lo scorrimento automatico' : 'Ferma lo scorrimento automatico');
        toggle.textContent = stopped ? '▶' : '❚❚';
      });
      carousel.addEventListener('pointerenter', () => { busy = true; });
      carousel.addEventListener('pointerleave', () => { busy = false; });
      carousel.addEventListener('focusin', () => { busy = true; });
      carousel.addEventListener('focusout', () => { busy = false; });
      // slow continuous drift (about 18 px per second), back and forth between the two ends.
      // Snap and smooth scrolling are switched off only while drifting, so manual scrolling still snaps.
      let direction = 1;
      let x = track.scrollLeft;
      let last = 0;
      let drifting = false;
      const setDrifting = (on: boolean) => {
        if (on === drifting) return;
        drifting = on;
        track.style.scrollSnapType = on ? 'none' : '';
        track.style.scrollBehavior = on ? 'auto' : '';
        if (on) x = track.scrollLeft;
      };
      const frame = (now: number) => {
        const dt = Math.min(now - (last || now), 50);
        last = now;
        if (stopped || busy || document.hidden || anySheetOpen()) setDrifting(false);
        else {
          setDrifting(true);
          const max = track.scrollWidth - track.clientWidth;
          x += direction * 0.018 * dt;
          if (x >= max) { x = max; direction = -1; }
          if (x <= 0) { x = 0; direction = 1; }
          track.scrollLeft = x;
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>

<style>
  .intro { padding-bottom: 1rem; }
  .carousel { padding-top: 3rem; }
  .carousel-head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: end; justify-content: space-between; }
  .carousel-head h2 { margin: 0; }
  .carousel-controls { display: flex; gap: .5rem; }
  .ctl {
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    border: 1px solid var(--accent); background: var(--card); color: var(--accent);
    font: inherit; font-size: 1.1rem; line-height: 1; cursor: pointer; touch-action: manipulation;
  }
  .ctl:hover { background: var(--accent); color: #fff; }
  .ctl[aria-pressed='true'] { background: var(--accent); color: #fff; }

  /* the track runs edge to edge, starting aligned with the page container */
  .track {
    --edge: max(1.25rem, calc((100vw - var(--max)) / 2 + 1.25rem));
    position: relative;
    display: flex; gap: 1.25rem;
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    padding: 2.25rem var(--edge) 2.5rem;   /* vertical room for the lifted card and its glow */
    scrollbar-width: thin; touch-action: pan-x pan-y;
  }
  @media (prefers-reduced-motion: no-preference) { .track { scroll-behavior: smooth; } }
  .slide {
    position: relative; flex: 0 0 min(82vw, 25rem); scroll-snap-align: start;
    display: flex; flex-direction: column;
    transition: transform .25s, box-shadow .25s, opacity .25s, filter .25s;
  }
  .slide h3 { font-size: 1.5rem; }
  .slide .tags { margin-bottom: 1.25rem; }
  .num { font-family: var(--font-display); color: var(--accent); margin: 0 0 1rem; letter-spacing: .08em; }
  .summary { font-size: 1.05rem; }
  .business { color: var(--muted); margin: 0 0 .9rem; }
  .site { padding: 0; overflow: hidden; }
  .site-body { padding: 1.25rem 1.5rem 1.5rem; display: flex; flex-direction: column; flex: 1; }
  .site :global(.shot) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-bottom: 1px solid var(--line); }

  /* the whole card is the button */
  .open { margin-top: auto; align-self: start; padding: 0; border: 0; background: none; font: inherit; font-weight: 500; color: var(--accent); cursor: pointer; }
  .open::after { content: ''; position: absolute; inset: 0; }
  .open:focus-visible { outline: none; }
  .slide:has(.open:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* spotlight: the card under the pointer lights up, the others step back */
  @media (hover: hover) {
    .track:has(.slide:hover) .slide:not(:hover) { opacity: .45; filter: saturate(.5); }
    .slide:hover { transform: translateY(-6px) scale(1.02); border-color: var(--cta); box-shadow: 0 0 0 3px var(--marker), 0 18px 40px rgba(35, 38, 43, .22); z-index: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; } .slide:hover { transform: none; } }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* ---------- "projected" sheet ---------- */
  .sheet {
    /* always in the middle of the screen and never taller than it: long sheets scroll inside */
    position: fixed; inset: 0; margin: auto;
    width: min(38rem, calc(100vw - 1.5rem)); height: fit-content; max-height: min(76vh, 40rem);
    overflow-y: auto; font-size: 1rem;
    padding: 0; border: 0; border-radius: 10px;
    background: var(--card); color: var(--ink);
    /* warm halo, as if lit by a projector */
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .25), 0 0 90px 10px rgba(255, 224, 138, .38), 0 30px 80px rgba(0, 0, 0, .55);
  }
  .sheet:modal { overscroll-behavior: contain; }
  .sheet::backdrop {
    /* dim the page, a little lighter around the sheet */
    background: radial-gradient(ellipse 60% 55% at 50% 45%, rgba(60, 52, 30, .62), rgba(14, 16, 19, .86) 75%);
    backdrop-filter: blur(3px);
    overflow: hidden; overscroll-behavior: contain;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sheet[open] { animation: project .3s cubic-bezier(.2, .8, .2, 1); }
    .sheet[open]::backdrop { animation: dim .3s ease-out; }
  }
  @keyframes project { from { opacity: 0; transform: scale(.88); filter: brightness(1.8); } }
  @keyframes dim { from { opacity: 0; } }

  .sheet-close { position: sticky; top: 0; z-index: 1; display: flex; justify-content: flex-end; height: 0; }
  .sheet-close button {
    margin: .6rem; width: 2.5rem; height: 2.5rem; border-radius: 50%;
    border: 1px solid var(--line); background: var(--card); color: var(--ink);
    font-size: 1.5rem; line-height: 1; cursor: pointer;
  }
  .sheet-close button:hover { background: var(--ink); color: #fff; }
  .sheet :global(.sheet-shot) { width: 100%; aspect-ratio: 16 / 6; object-fit: cover; object-position: top; border-bottom: 1px solid var(--line); }
  .sheet-body { padding: 1.5rem 1.75rem 1.75rem; }
  .sheet-body h2 { font-size: 1.6rem; padding-right: 2.5rem; }
  .sheet-body .summary { font-size: 1rem; }
  .sheet-body h3 { font-family: var(--font-body); font-size: .8rem; font-weight: 500; text-transform: uppercase; letter-spacing: .12em; color: var(--accent); margin-top: 1.5rem; }
  .note { font-style: italic; color: var(--muted); }
  .links { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 1.5rem; font-weight: 500; }
  .linklike { padding: 0; border: 0; background: none; font: inherit; font-weight: 500; color: var(--accent); text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
</style>
