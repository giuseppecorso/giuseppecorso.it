---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const progetti = (await getCollection('progetti')).sort((a, b) => a.data.order - b.data.order);
const clienti = (await getCollection('clienti')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(progetti.map(async (p) => ({ p, Content: (await render(p)).Content })));
---

<BaseLayout
  title="Progetti software e siti web realizzati — Giuseppe Corso"
  description="Progetti software di Giuseppe Corso: e-commerce Spring Boot e Angular, analisi statistica in Python, automazioni Excel/VBA. Più i siti web che ho realizzato."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Portfolio</p>
      <h1>Progetti</h1>
      <p class="lead">Per ogni progetto: il problema, cosa ho costruito, con quali tecnologie e dove vederlo.</p>

      <div class="projects">
        {rendered.map(({ p, Content }) => (
          <article class="card project" id={p.id}>
            <h2>{p.data.title}</h2>
            <p class="summary">{p.data.summary}</p>
            <h3>Il problema</h3>
            <p>{p.data.problem}</p>
            <h3>Cosa ho costruito</h3>
            <Content />
            {p.data.note && <p class="note">{p.data.note}</p>}
            <ul class="tags" aria-label="Tecnologie">
              {p.data.tech.map((t) => <li>{t}</li>)}
            </ul>
            {p.data.links.length > 0 && (
              <ul class="links">
                {p.data.links.map((l) => (
                  <li><a href={l.url} rel="noopener">{l.label} →</a></li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="clienti">
    <div class="container">
      <p class="eyebrow">Online</p>
      <h2 id="clienti">Siti web realizzati</h2>
      <div class="grid grid--2 sites">
        {clienti.map((c) => (
          <article class="card client">
            <Image
              src={c.data.screenshot}
              alt={c.data.screenshotAlt}
              widths={[400, 800]}
              sizes="(min-width: 48rem) 50vw, 100vw"
              class="shot"
            />
            <h3>{c.data.title}</h3>
            <p class="business">{c.data.business}</p>
            <p>{c.data.work}</p>
            <ul class="tags" aria-label="Tecnologie">
              {c.data.tech.map((t) => <li>{t}</li>)}
            </ul>
            <p class="visit">
              {c.data.url && <a href={c.data.url} rel="noopener">Visita il sito →</a>}
              {c.data.detailUrl && <a href={c.data.detailUrl}>Dettagli tecnici ↑</a>}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects { display: grid; gap: 1.5rem; margin-top: 2rem; }
  .project h2 { font-size: 1.75rem; }
  .project h3 { font-family: var(--font-body); font-size: .8rem; font-weight: 500; text-transform: uppercase; letter-spacing: .12em; color: var(--accent); margin-top: 1.5rem; }
  .summary { font-size: 1.1rem; }
  .note { font-style: italic; color: var(--muted); }
  .links { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 1.5rem; font-weight: 500; }
  .client { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .client > :not(.shot) { margin-left: 1.25rem; margin-right: 1.25rem; }
  .client h3 { margin-top: 1rem; }
  .client .tags { margin-bottom: 1rem; }
  .shot { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-bottom: 1px solid var(--line); }
  .business { color: var(--muted); font-size: .9rem; margin: 0; }
  .visit { margin-top: auto; padding-bottom: 1.25rem; display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .sites { margin-top: 2rem; }
</style>
