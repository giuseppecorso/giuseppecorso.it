---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';
---

<BaseLayout
  title="Contatti — Giuseppe Corso"
  description="Come contattare Giuseppe Corso: email, LinkedIn, GitHub e Fiverr. Per proposte di lavoro, progetti software e assistenza su WordPress, WooCommerce e PrestaShop."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Contatti</p>
      <h1>Parliamone: <span class="mark">scrivimi</span>.</h1>
      <p class="lead">
        Una proposta di lavoro, un progetto da costruire o un sito che non funziona come dovrebbe: scegli il canale più comodo per te.
      </p>

      <div class="email card">
        <div>
          <h2>Email</h2>
          <p class="address">{SITE.email}</p>
          <p class="hint">Per proposte di lavoro, collaborazioni e domande sui miei progetti.</p>
        </div>
        <div class="email-actions">
          <button type="button" class="btn btn--primary" data-copy={SITE.email} hidden>Copia indirizzo</button>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`}>Apri il programma di posta</a>
          <span class="copied" role="status" aria-live="polite"></span>
        </div>
      </div>

      <div class="grid grid--3 channels">
        <article class="card">
          <h2>LinkedIn</h2>
          <p>Per recruiter e aziende: il mio percorso professionale e un messaggio diretto.</p>
          <a href={SITE.linkedin} rel="noopener">Vai al profilo LinkedIn →</a>
        </article>
        <article class="card">
          <h2>GitHub</h2>
          <p>Il codice sorgente dei miei progetti pubblici.</p>
          <a href={SITE.github} rel="noopener">Vai al profilo GitHub →</a>
        </article>
        <article class="card">
          <h2>Fiverr</h2>
          <p>Per assistenza su WordPress, WooCommerce e PrestaShop: preventivo e pagamento passano dalla piattaforma.</p>
          <a href={SITE.fiverr} rel="noopener">Vai al profilo Fiverr →</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: the copy button only appears when the Clipboard API exists.
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('.copied');
  if (button && status && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      status.textContent = 'Indirizzo copiato.';
    });
  }
</script>

<style>
  h2 { font-size: 1.4rem; margin: 0 0 .5rem; }
  .email { margin-top: 3rem; display: grid; gap: 1.5rem; align-items: center; }
  .address { font-family: var(--font-display); font-size: clamp(1.4rem, 4.5vw, 2rem); font-weight: 340; margin: 0 0 .5rem; overflow-wrap: anywhere; user-select: all; }
  .hint { color: var(--muted); margin: 0; }
  .email-actions { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  .email-actions .btn { font: inherit; font-weight: 500; cursor: pointer; }
  .copied { color: var(--muted); font-size: .95rem; }
  .channels { margin-top: 1.25rem; }
  .channels p { margin: 0 0 1rem; }
  @media (min-width: 48rem) {
    .email { grid-template-columns: 1fr auto; padding: 2.25rem; }
  }
</style>
