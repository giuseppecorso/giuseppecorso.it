---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import character from '../assets/personaggio/personaggio-perso.jpg';
---

<BaseLayout
  title="Pagina non trovata — Giuseppe Corso"
  description="La pagina che cerchi non esiste o è stata spostata."
  noindex
>
  <section class="section">
    <div class="container lost">
      <div>
        <p class="eyebrow">Errore 404</p>
        <h1>Questa pagina <span class="mark">non la trovo</span> nemmeno io.</h1>
        <p class="lead">Forse l'indirizzo è sbagliato, oppure la pagina è stata spostata.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/">Torna alla home</a>
          <a class="btn btn--ghost" href="/progetti/">Guarda i progetti</a>
        </div>
      </div>
      <Image
        src={character}
        alt="Giuseppe Corso disegnato a matita che guarda una mappa grattandosi la testa, perplesso"
        widths={[340, 680]}
        sizes="(min-width: 48rem) 340px, 70vw"
        class="character"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .lost { display: grid; gap: 2.5rem; align-items: center; }
  .character { justify-self: center; width: min(70vw, 340px); height: auto; mix-blend-mode: multiply; }
  @media (min-width: 48rem) {
    .lost { grid-template-columns: 1fr auto; gap: 4rem; }
  }
</style>
