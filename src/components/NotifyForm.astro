---
// "Notify me" form: plain HTML POST to listmonk (double opt-in list), no JavaScript.
interface Props {
  listId: string;
}
const { listId } = Astro.props;
---

<form class="notify" method="post" action="https://lista.giuseppecorso.it/subscription/form">
  <input type="hidden" name="l" value={listId} />
  <!-- honeypot: must stay empty, bots fill it -->
  <div class="hp" aria-hidden="true">
    <label for="nonce">Lascia vuoto questo campo</label>
    <input id="nonce" name="nonce" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <label for="email">La tua email</label>
  <div class="row">
    <input id="email" name="email" type="email" required autocomplete="email" placeholder="nome@esempio.it" />
    <button class="btn btn--primary" type="submit">Avvisami quando esce</button>
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    <span>
      Acconsento a ricevere un'email quando il prodotto sarà disponibile.
      Ho letto l'<a href="/privacy/">informativa sulla privacy</a>.
    </span>
  </label>

  <p class="hint">Riceverai un'email con un link per confermare l'iscrizione. Puoi cancellarti in ogni momento.</p>
</form>

<style>
  .notify { max-width: 36rem; }
  .notify > label:not(.consent) { display: block; font-weight: 600; margin-bottom: .4rem; }
  .row { display: flex; flex-wrap: wrap; gap: .6rem; }
  input[type='email'] {
    flex: 1 1 14rem;
    font: inherit;
    padding: .8rem 1rem;
    border: 1px solid #7b8089;
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
  }
  button { font: inherit; font-weight: 500; cursor: pointer; }
  .consent { display: flex; gap: .6rem; align-items: flex-start; margin-top: 1rem; font-size: .95rem; }
  .consent input { width: 1.2rem; height: 1.2rem; margin-top: .2rem; flex: none; }
  .hint { color: var(--muted); font-size: .9rem; margin-bottom: 0; }
  .hp { position: absolute; left: -9999px; }
</style>
